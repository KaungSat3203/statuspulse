# Backend: copy to backend/.env and fill values locally. Never commit secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST/statuspulse?sslmode=require
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
# Generate your own value with: openssl rand -base64 32
# Share this key across API instances; never expose it to browser code.
AUTH_RATE_LIMIT_KEY=
SESSION_TTL=168h
# Empty means no trusted forwarded-IP headers.
TRUSTED_PROXY_CIDRS=
