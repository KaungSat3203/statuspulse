# Server-only configuration. Copy to frontend/.env.local.
APP_ENV=development
STATUSPULSE_API_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:3000
# Enable only behind an edge proxy that overwrites X-Forwarded-For.
STATUSPULSE_TRUST_PROXY_IP=false
# NEXT_PUBLIC_STATUSPULSE_API_URL is no longer used; browser traffic uses /api.
